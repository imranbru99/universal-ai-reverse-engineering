# Core
APP_NAME=REVERSEFORGE AI
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=reverseforge
POSTGRES_PASSWORD=reverseforge
POSTGRES_DB=reverseforge
DATABASE_URL=postgresql+psycopg://reverseforge:reverseforge@postgres:5432/reverseforge

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object storage (MinIO)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reverseforge
S3_REGION=us-east-1

# Public URLs
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
DEMO_TARGET_URL=http://demo-target:3100

# AI (optional — heuristics used when empty)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Exploration defaults
DEFAULT_MAX_DEPTH=4
DEFAULT_MAX_PAGES=40
DEFAULT_MAX_MINUTES=10
